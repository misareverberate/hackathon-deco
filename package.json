{
  "name": "ai-commerce-readiness-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts",
    "test:web": "npm --prefix web run test",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "tsx server.ts",
    "dev:server": "tsx watch server.ts",
    "dev:web": "npm --prefix web run dev",
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\""
  },
  "dependencies": {
    "cheerio": "^1.0.103",
    "fast-xml-parser": "^5.10.1",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0"
  }
}
